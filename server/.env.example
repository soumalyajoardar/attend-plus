# Attend+ Server - Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env to git.

# MongoDB connection string (from MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/attend-plus?retryWrites=true&w=majority

# JWT signing secret - use a long, random string in production
# e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# The origin of your React frontend (used for CORS allowlist)
# Defaults to https://attend-plus.onrender.com if not set
CLIENT_URL=https://attend-plus.onrender.com

# Server port (Render sets this automatically; only needed for local dev)
PORT=5000

# Institution timezone for local date/time on attendance records (default: Asia/Kolkata)
INSTITUTION_TZ=Asia/Kolkata

# Admin teacher credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_TEACHER_ID=ADMIN-2026
ADMIN_TEACHER_PASSWORD=admin@2026
ADMIN_TEACHER_EMAIL=admin@attendplus.com

# Test student credentials (for development only, disable in production)
TEST_STUDENT_EMAIL=student@test.com
TEST_STUDENT_PASSWORD=student@123
